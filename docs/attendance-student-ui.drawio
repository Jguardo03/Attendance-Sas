600;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="295" y="362" width="145" height="40" as="geometry"/></mxCell><mxCell id="acd2" value="lecturer&lt;br&gt;users.first_name + last_name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;;strokeColor=#FF6600;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="295" y="408" width="145" height="40" as="geometry"/></mxCell><mxCell id="acd3" value="location&lt;br&gt;location.name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;;strokeColor=#FF6600;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="295" y="454" width="145" height="40" as="geometry"/></mxCell><mxCell id="acs" value="tap: class" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;;strokeColor=#FF6600;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="295" y="500" width="145" height="30" as="geometry"/></mxCell><mxCell id="aw" value="week picker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="470" y="180" width="170" height="36" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;" edge="1" parent="1" source="cal" target="aw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="aw1" value="sessions of picked day&lt;br&gt;(all lecturers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;;strokeColor=#FF6600;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="226" width="170" height="46" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;" edge="1" parent="1" source="cal" target="aw1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="aw2" value="session (list item)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;;strokeColor=#FF6600;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="485" y="282" width="155" height="32" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;" edge="1" parent="1" source="aw1" target="aw2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="aw3" value="same fields as Home&lt;br&gt;list item" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontColor=#555555;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="495" y="322" width="145" height="46" as="geometry"/></mxCell><mxCell id="aws" value="tap: session" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;;strokeColor=#FF6600;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="495" y="376" width="145" height="30" as="geometry"/></mxCell><mxCell id="qb" value="Queries behind the three tabs (one row per session or schedule)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="-280" y="640" width="1560" height="230" as="geometry"/></mxCell><mxCell id="q1" value="Home&lt;br&gt;SELECT DISTINCT cs.id, c.name, start, end, lecturer, location, cs.status&lt;br&gt;FROM class_session cs JOIN class_schedule s JOIN class c&lt;br&gt;JOIN users l ON l.id = s.lecturer_id JOIN location&lt;br&gt;WHERE cs.session_date = CURRENT_DATE&lt;br&gt;AND cs.status IN (&#x27;scheduled&#x27;,&#x27;rescheduled&#x27;,&#x27;started&#x27;)&lt;br&gt;AND COALESCE(cs.override_end_time, s.end_time) &amp;gt; LOCALTIME&lt;br&gt;ORDER BY start" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontColor=#555555;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="-260" y="680" width="500" height="170" as="geometry"/></mxCell><mxCell id="q2" value="Calendar&lt;br&gt;Same SELECT DISTINCT as Home&lt;br&gt;WHERE cs.session_date = :picked_day&lt;br&gt;(all statuses, including finished and cancelled)&lt;br&gt;ORDER BY start&lt;br&gt;&lt;br&gt;start = COALESCE(cs.override_start_time, s.start_time)&lt;br&gt;location = COALESCE(cs.override_location_id, s.location_id)" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontColor=#555555;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="260" y="680" width="480" height="170" as="geometry"/></mxCell><mxCell id="q3" value="Classes&lt;br&gt;SELECT DISTINCT s.id, c.name, s.week_day, s.start_time, lecturer, location&lt;br&gt;FROM class_schedule s JOIN class c JOIN academic_period p ...&lt;br&gt;WHERE p.status = &#x27;active&#x27;  (filter: p.id = :period_id)&lt;br&gt;ORDER BY c.name, s.week_day&lt;br&gt;&lt;br&gt;Percentages come from separate GROUP BY queries,&lt;br&gt;never from joining attendance into these lists." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontColor=#555555;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="760" y="680" width="500" height="170" as="geometry"/></mxCell><mxCell id="a0" value="Periods" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;;strokeColor=#FF6600;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="690" y="180" width="150" height="32" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;" edge="1" parent="1" source="adm" target="a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a1" value="Classes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;;strokeColor=#FF6600;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="690" y="220" width="150" height="32" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;" edge="1" parent="1" source="a0" target="a1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a2" value="Schedules" style="rounded=1;whit