{
  "expo": {
    "name": "Attendancely",
    "slug": "attendance-sas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "attendancesas",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.attendancely.app"
    },
    "android": {
      "package": "com.attendancely.app",
      "adaptiveIcon": {
        "backgroundColor": "#015C93",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      ["expo-camera", { "cameraPermission": "Allow Attendancely to use the camera to read the QR code shown in the room." }],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#015C93",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
